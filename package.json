{
  "name": "sodec-ai-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @sodec/api",
    "dev:admin": "npm run dev -w @sodec/admin",
    "lint": "eslint . --max-warnings=0",
    "start": "npm run start -w @sodec/api",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed": "tsx prisma/seed.ts",
    "provision:elevenlabs": "tsx scripts/provision-elevenlabs-agents.ts",
    "smoke:google": "tsx scripts/google-workspace-smoke.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.65.0",
    "fastify": "^5.6.2",
    "googleapis": "^173.0.0",
    "ioredis": "^5.8.2",
    "next": "^15.5.6",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twilio": "^5.10.6",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.6"
  }
}
